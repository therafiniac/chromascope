---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist.">
  <h1 class="text-3xl font-semibold tracking-tight">Page not found</h1>
  <p class="text-muted-foreground mt-4">
    That page does not exist, or you are offline and it has not been saved yet.
  </p>
  <p class="mt-4">
    <a href="/" class="underline underline-offset-4">
      Back to the home page
    </a>
  </p>
</BaseLayout>
