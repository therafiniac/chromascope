---
import { Palette } from '@lucide/astro';

import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Lab"
  description="Analyze the colors of a photo on your device."
>
  <h1 class="flex items-center gap-3 text-3xl font-semibold tracking-tight">
    <Palette aria-hidden="true" />
    Lab
  </h1>
  <p class="text-muted-foreground mt-4 max-w-2xl">
    The color Lab is coming soon. This page is a placeholder for it.
  </p>
</BaseLayout>
